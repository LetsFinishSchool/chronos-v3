# V-6: KI-Zugang für die Spikes. Datei nach ~/.config/chronos-spike/anthropic.env kopieren (Modus 600), Schlüssel eintragen.
# Niemals ins Repository. stack.sh liest die Datei, wenn ANTHROPIC_API_KEY nicht schon gesetzt ist.
ANTHROPIC_API_KEY=
# optional, günstiges Modell; Standard der Spikes: claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5
