  {
   "id": "text-123",
   "type": "text",
   "x": 344,
   "y": 1256,
   "width": 431.20000000000005,
   "height": 460,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
