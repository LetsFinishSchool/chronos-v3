  {
   "id": "text-333",
   "type": "text",
   "x": 16,
   "y": 7130,
   "width": 277.20000000000005,
   "height": 300,
   "angle": 0,
   "strokeColor": "#4b5563",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
