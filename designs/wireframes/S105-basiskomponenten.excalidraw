   "lineHeight": 1.4667,
   "autoResize": true
  },
  {
   "id": "text-46",
   "type": "text",
   "x": 344,
   "y": 204,
   "width": 438.90000000000003,
   "height": 340,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
