#!/usr/bin/env bash
# post-checkout: kopiert beim Anlegen eines neuen Worktrees die in
# .worktreekeep gelisteten (gitignorierten) Dateien aus dem Haupt-Worktree.
# Aktivierung einmalig pro Klon: git config core.hooksPath .githooks
set -u

prev="$1" flag="$3"
# Nur Branch-Checkout direkt nach `git worktree add` (alter Stand = Null-Hash).
[ "$flag" = "1" ] || exit 0
case "$prev" in *[!0]*) exit 0 ;; esac

target="$(git rev-parse --show-toplevel)"
# Erster Eintrag von `git worktree list` ist der Haupt-Worktree.
main="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
[ -n "$main" ] && [ "$main" != "$target" ] || exit 0

# Liste des Haupt-Worktrees zuerst: sie ist aktuell, auch bei uncommitteten Änderungen.
list="$main/.worktreekeep"
[ -f "$list" ] || list="$target/.worktreekeep"
[ -f "$list" ] || exit 0

while IFS= read -r entry || [ -n "$entry" ]; do
  entry="${entry%$'\r'}"
  case "$entry" in ''|'#'*) continue ;; esac
  # Nur relative Pfade innerhalb des Repos zulassen.
  case "$entry" in /*|..|../*|*/..|*/../*)
    echo "post-checkout: überspringe unzulässigen Pfad '$entry'" >&2; continue ;;
  esac
  src="$main/$entry"; dst="$target/$entry"
  if [ ! -e "$src" ]; then
    echo "post-checkout: '$entry' fehlt im Haupt-Worktree, übersprungen" >&2; continue
  fi
  [ -e "$dst" ] && continue   # nie überschreiben
  mkdir -p "$(dirname "$dst")"
  cp -pR "$src" "$dst" && echo "post-checkout: '$entry' kopiert"
done < "$list"
exit 0
